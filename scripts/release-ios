#!/usr/bin/env bash
# Archive the iOS app and upload it to App Store Connect for TestFlight.
#
# Usage: scripts/release-ios [build-number]     (defaults to project.yml's CURRENT_PROJECT_VERSION)
#
# App Store Connect rejects an upload whose version and build both match one it
# already has, so pass a higher build number when re-uploading the same rules.
# The version itself comes from MARKETING_VERSION, which update-rules date-stamps.
#
# Auth uses the same App Store Connect API key as notarization. The issuer ID
# lives in App Store Connect > Users and Access > Integrations:
#   export ASC_ISSUER_ID=<uuid>
set -euo pipefail

TEAM_ID=2ZPA772V9V
SCHEME=Hush-iOS
APP_NAME=Hush

ASC_KEY_ID="${ASC_KEY_ID:-8TPMZ548QG}"
ASC_KEY_PATH="${ASC_KEY_PATH:-$HOME/.appstoreconnect/private_keys/AuthKey_$ASC_KEY_ID.p8}"
: "${ASC_ISSUER_ID:?set ASC_ISSUER_ID (App Store Connect > Users and Access > Integrations)}"
[ -f "$ASC_KEY_PATH" ] || { echo "API key not found at $ASC_KEY_PATH" >&2; exit 1; }

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
VERSION=$(awk '/^ *MARKETING_VERSION:/{print $2; exit}' "$ROOT/project.yml")
BUILD="${1:-$(awk '/^ *CURRENT_PROJECT_VERSION:/{print $2; exit}' "$ROOT/project.yml")}"

OUT="$ROOT/build/ios"
ARCHIVE="$OUT/$APP_NAME.xcarchive"
APP="$ARCHIVE/Products/Applications/$APP_NAME.app"
APPEX="$APP/PlugIns/Content Blocker.appex"

AUTH=(
  -authenticationKeyPath "$ASC_KEY_PATH"
  -authenticationKeyID "$ASC_KEY_ID"
  -authenticationKeyIssuerID "$ASC_ISSUER_ID"
)

rm -rf "$OUT"
mkdir -p "$OUT"

cat > "$OUT/ExportOptions.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>teamID</key>
    <string>$TEAM_ID</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>destination</key>
    <string>upload</string>
    <key>uploadSymbols</key>
    <true/>
    <!-- Keep the numbers this script passed; Xcode otherwise rewrites them. -->
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
EOF

printf '==> Archiving %s %s (build %s)\n' "$SCHEME" "$VERSION" "$BUILD"
xcodebuild archive \
  -project "$ROOT/Hush.xcodeproj" \
  -scheme "$SCHEME" \
  -configuration Release \
  -destination 'generic/platform=iOS' \
  -archivePath "$ARCHIVE" \
  -allowProvisioningUpdates \
  "${AUTH[@]}" \
  MARKETING_VERSION="$VERSION" \
  CURRENT_PROJECT_VERSION="$BUILD"

# A build without the extension and its rules is a silent no-op ad blocker.
printf '==> Verifying the content blocker\n'
[ -d "$APPEX" ] || { echo "Content Blocker.appex missing from the archive" >&2; exit 1; }
[ -f "$APPEX/blockerList.json" ] || { echo "blockerList.json missing from the appex" >&2; exit 1; }

printf '==> Uploading to App Store Connect\n'
xcodebuild -exportArchive \
  -archivePath "$ARCHIVE" \
  -exportPath "$OUT/export" \
  -exportOptionsPlist "$OUT/ExportOptions.plist" \
  -allowProvisioningUpdates \
  "${AUTH[@]}"

cat <<EOF

==> Uploaded.
  Version : $VERSION
  Build   : $BUILD

Processing takes a few minutes. Then in App Store Connect > TestFlight:
  * internal testers get it with no review
  * external testers need Beta App Review plus test notes
EOF
